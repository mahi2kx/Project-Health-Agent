# =============================================================================
# Project Health Reporting Agent — .gitignore
# =============================================================================

# --- Environment & Secrets ---
.env
.env.local
.env.production

# --- Python Virtual Environment ---
venv/
.venv/
env/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Distribution / Build ---
dist/
build/
*.egg-info/
*.egg

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
*.cover

# --- Application Output Directories ---
uploads/*
reports/*
presentations/*
!uploads/.gitkeep
!reports/.gitkeep
!presentations/.gitkeep

# --- IDE & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS Files ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log

# --- Jupyter Notebooks (if any) ---
.ipynb_checkpoints/
