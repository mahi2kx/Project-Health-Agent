"""
Project Health Reporting Agent — Main Application
==================================================
AI-powered agent that analyzes project plans, evaluates health using
a RAG (Red-Amber-Green) framework, and generates executive-ready reports.

This file defines the Streamlit application skeleton.
Business logic will be added in subsequent implementation steps.
"""

import json
import os
